{
  "name": "rtduo-platform",
  "displayName": "RTDuo Platform",
  "description": "Use the published RTDuo Arduino builder image through Docker or Podman.",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "publisher": "rtbus",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:rtduo.compileArduinoExample",
    "onCommand:rtduo.openBuilderShell"
  ],
  "main": "./extension.js",
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "rtduo.builderShell",
          "title": "RTDuo Builder Shell"
        }
      ]
    },
    "commands": [
      {
        "command": "rtduo.compileArduinoExample",
        "title": "RTDuo: Compile Arduino Example"
      },
      {
        "command": "rtduo.openBuilderShell",
        "title": "RTDuo: Open Builder Shell"
      }
    ]
  }
}
