# SPDX-License-Identifier: MPL-2.0
ARG EMBEDDED_ZEPHYR_IMAGE=ghcr.io/embeddedcontainers/zephyr:arm-1.0.1SDK
FROM ${EMBEDDED_ZEPHYR_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/hudec-iot/rtbus"
LABEL org.opencontainers.image.description="RTBus embedded ARM build environment"

ARG ZEPHYR_SDK_VERSION=1.0.0
ARG RTBUS_ZEPHYR_WORKSPACE=/opt/rtbus/zephyr-workspace
ARG ARDUINO_CLI_VERSION=1.5.1
ARG JLINK_VERSION=970
ARG JLINK_DOWNLOAD_URL=https://www.segger.com/downloads/jlink/JLink_Linux_V${JLINK_VERSION}_x86_64.tgz

USER root

ENV ZEPHYR_TOOLCHAIN_VARIANT=zephyr
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/toolchains/zephyr-sdk-${ZEPHYR_SDK_VERSION}
ENV RTBUS_ZEPHYR_WORKSPACE=${RTBUS_ZEPHYR_WORKSPACE}
ENV ZEPHYR_BASE=${RTBUS_ZEPHYR_WORKSPACE}/zephyr
ENV ARDUINO_UPDATER_ENABLE_NOTIFICATION=false
ENV JLINK_TOOL_PATH=/opt/segger/jlink
ENV PATH=/opt/segger/jlink:/opt/venv/bin:${ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin:${PATH}

COPY LICENSE NOTICE SOURCE_INFO.md THIRD_PARTY_NOTICES.md /usr/share/doc/rtbus/

WORKDIR /workdir

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        g++ \
        git \
        make \
        tcc \
        libusb-1.0-0 \
        libudev1 \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        gh \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        'PyYAML>=6.0' \
        anytree \
        canopen \
        cbor2 \
        click \
        'cryptography>=40.0.0' \
        intelhex \
        jsonschema \
        packaging \
        'patool>=2.0.0' \
        'psutil>=5.6.6' \
        'pyelftools>=0.29' \
        pykwalify \
        pylink-square \
        pyserial \
        pytest \
        'requests>=2.32.4' \
        'reuse>=6.0.0' \
        semver \
        setuptools \
        'tqdm>=4.67.1' \
        'west>=0.14.0' \
    && python3 -c "import jsonschema; import cryptography; import cbor2" \
    && west --version \
    && cmake --version \
    && ninja --version \
    && make --version \
    && git --version \
    && gh --version \
    && tcc -v \
    && test -d ${ZEPHYR_SDK_INSTALL_DIR} \
    && test -x ${ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc \
    && arm-zephyr-eabi-gcc --version

RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh \
        | BINDIR=/usr/local/bin sh -s ${ARDUINO_CLI_VERSION} \
    && arduino-cli version

# Keep the complete official distribution, including libraries and notices.
# The official download form requires acceptance of SEGGER's terms of use.
RUN curl -fSL --retry 3 \
        --data 'accept_license_agreement=accepted&submit=Download+software' \
        "${JLINK_DOWNLOAD_URL}" -o /tmp/rtbus-jlink.tgz \
    && mkdir -p "${JLINK_TOOL_PATH}" \
    && tar -xzf /tmp/rtbus-jlink.tgz --strip-components=1 -C "${JLINK_TOOL_PATH}" \
    && test -x "${JLINK_TOOL_PATH}/JLinkExe" \
    && rm -f /tmp/rtbus-jlink.tgz

LABEL org.opencontainers.image.source="https://github.com/hudec-iot/rtbus"
LABEL org.opencontainers.image.description="RTBus embedded ARM build environment"
